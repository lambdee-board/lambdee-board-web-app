#!/usr/bin/env bash

script_dir=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
. $script_dir/shell_helper "$@"

title "Forcing resetting the database"

psql -h /tmp -d template1 -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'lambdee_board_web_app_development' AND pid <> pg_backend_pid();" &>/dev/null || true

DISABLE_DATABASE_ENVIRONMENT_CHECK=1 $script_dir/rails db:reset
